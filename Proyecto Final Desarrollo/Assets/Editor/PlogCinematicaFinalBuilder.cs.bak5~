    static Material MatParticula()
    {
        string p = Carpeta + "/Mat_Particula.mat";
        var m = AssetDatabase.LoadAssetAtPath<Material>(p);
        if (m == null)
        {
            var sh = Shader.Find("Universal Render Pipeline/Particles/Unlit"); if (sh == null) sh = Shader.Find("Sprites/Default");
            m = new Material(sh); AssetDatabase.CreateAsset(m, p);
        }
        var tex = AssetDatabase.GetBuiltinExtraResource<Texture2D>("Default-Particle.psd");
        if (tex != null && m.HasProperty("_BaseMap")) m.SetTexture("_BaseMap", tex);
        if (m.HasProperty("_Surface")) { m.SetFloat("_Surface", 1f); m.SetFloat("_Blend", 2f); m.SetFloat("_SrcBlend", 5f); m.SetFloat("_DstBlend", 1f); m.SetFloat("_ZWrite", 0f); m.EnableKeyword("_SURFACE_TYPE_TRANSPARENT"); m.renderQueue = 3000; }
        EditorUtility.SetDirty(m);
        return m;
    }

    static GameObject Particulas(string nombre, Vector3 local, Color c1, Color c2, float tam, float tasa, float radio, float velY, float orbital)
    {
        var go = new GameObject(nombre); go.transform.SetParent(setRoot, true); go.transform.position = O + local;
        var ps = go.AddComponent<ParticleSystem>();
        var main = ps.main; main.loop = true; main.startLifetime = 3f; main.startSpeed = 0f; main.startSize = tam;
        main.startColor = new ParticleSystem.MinMaxGradient(c1, c2); main.simulationSpace = ParticleSystemSimulationSpace.World; main.maxParticles = 400;
        var em = ps.emission; em.rateOverTime = tasa;
        var sh = ps.shape; sh.shapeType = ParticleSystemShapeType.Circle; sh.radius = radio; sh.rotation = new Vector3(-90f, 0, 0);
        var vel = ps.velocityOverLifetime; vel.enabled = true;
        vel.space = ParticleSystemSimulationSpace.World;
        vel.x = new ParticleSystem.MinMaxCurve(0f); vel.y = new ParticleSystem.MinMaxCurve(velY); vel.z = new ParticleSystem.MinMaxCurve(0f);
        if (Mathf.Abs(orbital) > 0.001f) vel.orbitalY = new ParticleSystem.MinMaxCurve(orbital);
        var col = ps.colorOverLifetime; col.enabled = true;
        var g = new Gradient(); g.SetKeys(new[] { new GradientColorKey(Color.white, 0f), new GradientColorKey(Color.white, 1f) }, new[] { new GradientAlphaKey(0f, 0f), new GradientAlphaKey(1f, 0.2f), new GradientAlphaKey(0f, 1f) });
        col.color = new ParticleSystem.MinMaxGradient(g);
        var r = go.GetComponent<ParticleSystemRenderer>(); r.sharedMaterial = MatParticula();
        go.SetActive(false);
        return go;
    }

    static GameObject PropDesierto(string nombre, Transform padre, Vector3 pos, float rotY, float esc)
    {
        var pf = AssetDatabase.LoadAssetAtPath<GameObject>(PropsDesierto + nombre + ".obj");
        if (pf == null) { Debug.LogWarning("[Cinematica] No encuentro " + nombre); return null; }
        var g = (GameObject)Object.Instantiate(pf); g.name = nombre;
        g.transform.SetParent(padre, true); g.transform.position = pos; g.transform.rotation = Quaternion.Euler(0, rotY, 0); g.transform.localScale = Vector3.one * esc;
        return g;
    }

    static bool EsFondoDesierto(Transform t)
    {
        for (var x = t; x != null; x = x.parent)
        {
            string n = x.name;
            if (n.Contains("Suelo") || n.Contains("Fondo") || n.Contains("Pared") || n.Contains("Meseta") || n.Contains("Terreno") || n.Contains("Perimetro") || n.Contains("Limite")
                || n.Contains("Pasto") || n.Contains("Mata_") || n.Contains("Directional") || n.Contains("Camera") || n.Contains("EventSystem")) return true;
        }
        return false;
    }

    static float DistXZ(Bounds b, Vector3 p)
    {
        var q = new Vector3(Mathf.Clamp(p.x, b.min.x, b.max.x), 0f, Mathf.Clamp(p.z, b.min.z, b.max.z));
        return Vector2.Distance(new Vector2(q.x, q.z), new Vector2(p.x, p.z));
    }

    // Busca el lugar mas despejado del escenario del desierto y pone ahi el origen del set
    static void CalcularOrigenDesierto()
    {
        var props = Object.FindObjectsByType<Renderer>(FindObjectsSortMode.None).Where(r => r != null && !EsFondoDesierto(r.transform)).Select(r => r.bounds).ToList();
        float mejor = -1f; Vector2 mp = new Vector2(4.5f, -9f);
        for (int x = -40; x <= 40; x += 2)
            for (int z = -40; z <= 40; z += 2)
            {
                var p = new Vector3(x, 0, z); float d = 999f;
                foreach (var b in props) { float dd = DistXZ(b, p); if (dd < d) d = dd; if (d < mejor) break; }
                d -= (Mathf.Abs(x) + Mathf.Abs(z)) * 0.02f;   // prefiere lugares cercanos al centro
                if (d > mejor) { mejor = d; mp = new Vector2(x, z); }
            }
        float y = 0f;
        var hits = Physics.RaycastAll(new Vector3(mp.x, 200f, mp.y), Vector3.down, 400f);
        float mejorDy = 999f;
        foreach (var h in hits) if (Mathf.Abs(h.point.y) < mejorDy) { mejorDy = Mathf.Abs(h.point.y); y = h.point.y; }
        O = new Vector3(mp.x, y, mp.y);
        Debug.Log("[CinematicaFinal] Origen del set en " + O + " (espacio libre aprox. " + mejor.ToString("0.0") + " m)");
    }

    // Apaga (solo en esta copia de la escena) los props que estorban dentro del radio del set
    static void DespejarEscenario(float radio)
    {
        int n = 0;
        foreach (var r in Object.FindObjectsByType<Renderer>(FindObjectsSortMode.None))
        {
            if (r == null || EsFondoDesierto(r.transform) || r.transform.IsChildOf(setRoot)) continue;
            if (DistXZ(r.bounds, O) < radio) { r.enabled = false; n++; }
        }
        Debug.Log("[CinematicaFinal] Se apagaron " + n + " props que estorbaban en el set.");
    }

    // Base escalonada de piedra arenisca con aro brillante (reemplaza al disco plano)
    static GameObject PedestalEsc(string nombre, Vector3 local, Color brillo)
    {
        var raiz = new GameObject(nombre); raiz.transform.SetParent(setRoot, true); raiz.transform.position = O + local;
        var claro = Mat("ArenaClara", new Color(0.80f, 0.62f, 0.42f));
        var oscuro = Mat("ArenaOscura", new Color(0.62f, 0.42f, 0.28f));
        void Piso(string n, float diam, float alto, float y, Material m)
        {
            var g = GameObject.CreatePrimitive(PrimitiveType.Cylinder); g.name = n; Object.DestroyImmediate(g.GetComponent<Collider>());
            g.transform.SetParent(raiz.transform, true);
            g.transform.position = O + local + Vector3.up * (y + alto * 0.5f);
            g.transform.localScale = new Vector3(diam, alto * 0.5f, diam);
            g.GetComponent<Renderer>().sharedMaterial = m;
        }
        Piso("Escalon_1", 2.8f, 0.30f, 0f, oscuro);
        Piso("Escalon_2", 2.2f, 0.30f, 0.30f, claro);
        Piso("Escalon_3", 1.6f, 0.20f, 0.60f, oscuro);
        var aro = GameObject.CreatePrimitive(PrimitiveType.Cylinder); aro.name = "Aro_Brillo"; Object.DestroyImmediate(aro.GetComponent<Collider>());
        aro.transform.SetParent(raiz.transform, true);
        aro.transform.position = O + local + Vector3.up * 0.805f;
        aro.transform.localScale = new Vector3(1.45f, 0.005f, 1.45f);
        aro.GetComponent<Renderer>().sharedMaterial = MatUnlit("AroBrillo_" + ColorUtility.ToHtmlStringRGB(brillo), brillo);
        raiz.SetActive(false);
        return raiz;
    }

